#!/usr/bin/env python3
"""Fetch school menu data from My School Menus and push to TRMNL."""

import argparse
import json
import os
import sys
import tomllib
from datetime import date, timedelta
from pathlib import Path

import requests

BASE_URL = "https://menus.healthepro.com/api"
TRMNL_URL = "https://trmnl.com/api/custom_plugins"

PROJECT_DIR = Path(__file__).resolve().parent.parent
CONFIG_PATH = PROJECT_DIR / "config.toml"
DATA_PATH = PROJECT_DIR / "tmp" / "data.json"
ENV_PATH = PROJECT_DIR / ".env"


def load_env():
    """Load variables from .env file if it exists."""
    if ENV_PATH.exists():
        for line in ENV_PATH.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                os.environ.setdefault(key.strip(), value.strip())


def load_config():
    with open(CONFIG_PATH, "rb") as f:
        return tomllib.load(f)


def fetch_site_name(org_id, site_id):
    url = f"{BASE_URL}/organizations/{org_id}/sites/{site_id}"
    resp = requests.get(url, timeout=15)
    if not resp.ok:
        return None
    return resp.json()["data"]["name"]


def fetch_date_overwrites(org_id, menu_id, year, month):
    url = f"{BASE_URL}/organizations/{org_id}/menus/{menu_id}/year/{year}/month/{month}/date_overwrites"
    resp = requests.get(url, timeout=15)
    if not resp.ok:
        print(f"Warning: no data for {year}-{month:02d} (HTTP {resp.status_code})")
        return []
    return resp.json()["data"]


def parse_day_items(overwrite):
    """Extract recipe names from a date_overwrites entry."""
    setting = json.loads(overwrite["setting"])

    # Check for days off (e.g. Spring Break, No School)
    days_off = setting.get("days_off", {})
    if isinstance(days_off, dict) and days_off.get("status"):
        desc = days_off.get("description", "No School")
        return {"items": [], "notice": desc}

    items = []
    for entry in setting.get("current_display", []):
        if entry.get("type") == "recipe":
            items.append(entry["name"])
    return {"items": items, "notice": None}


def get_target_dates(display_mode, today=None):
    """Return list of dates to fetch based on display mode."""
    if today is None:
        today = date.today()

    if display_mode == "today":
        return [today]
    elif display_mode == "today_tomorrow":
        return [today, today + timedelta(days=1)]
    elif display_mode == "week":
        # Monday through Friday; on weekends show next week
        weekday = today.weekday()
        if weekday >= 5:  # Saturday=5, Sunday=6
            monday = today + timedelta(days=(7 - weekday))
        else:
            monday = today - timedelta(days=weekday)
        return [monday + timedelta(days=i) for i in range(5)]
    else:
        print(f"Unknown display mode: {display_mode}, defaulting to today")
        return [today]


def format_date(d):
    return f"{d.strftime('%a, %b')} {d.day}"


def fetch_menu_data(config, today=None):
    msm = config["msm"]
    org_id = msm["organization_id"]
    display_mode = msm.get("display", "today")
    if today is None:
        today = date.today()
    target_dates = get_target_dates(display_mode, today)

    # Collect all months we need to fetch
    months_needed = set()
    for d in target_dates:
        months_needed.add((d.year, d.month))

    menus_data = []
    for menu_cfg in msm["menus"]:
        menu_id = menu_cfg["menu_id"]
        site_id = menu_cfg["site_id"]
        site_name = menu_cfg.get("site_name") or fetch_site_name(org_id, site_id) or "School"
        menu_name = menu_cfg.get("menu_name", "Menu")

        # Fetch date_overwrites for each needed month
        all_overwrites = {}
        for year, month in months_needed:
            overwrites = fetch_date_overwrites(org_id, menu_id, year, month)
            for ow in overwrites:
                all_overwrites[ow["day"]] = ow

        # Build days list
        days = []
        for d in target_dates:
            date_str = d.isoformat()
            if date_str in all_overwrites:
                parsed = parse_day_items(all_overwrites[date_str])
            else:
                parsed = {"items": [], "notice": None}
            days.append({
                "date": format_date(d),
                "date_short": d.strftime("%a"),
                "items": parsed["items"],
                "notice": parsed["notice"],
            })

        menus_data.append({
            "site_name": site_name,
            "menu_name": menu_name,
            "days": days,
        })

    return {
        "display": display_mode,
        "date": format_date(today),
        "menus": menus_data,
    }


def push_to_trmnl(data):
    uuid = os.environ.get("TRMNL_PLUGIN_UUID")
    if not uuid:
        print("TRMNL_PLUGIN_UUID not set, skipping push")
        return

    url = f"{TRMNL_URL}/{uuid}"
    resp = requests.post(url, json={"merge_variables": data}, timeout=15)
    resp.raise_for_status()
    print(f"Pushed to TRMNL: {resp.status_code}")


def main():
    load_env()

    parser = argparse.ArgumentParser(description="Fetch school menu data from My School Menus")
    parser.add_argument("--date", help="Simulate a specific date (YYYY-MM-DD)", default=None)
    args = parser.parse_args()

    today = None
    if args.date:
        today = date.fromisoformat(args.date)
        print(f"Simulating date: {today}")

    config = load_config()

    if "msm" not in config:
        print("No [msm] section in config.toml", file=sys.stderr)
        sys.exit(1)

    data = fetch_menu_data(config, today=today)

    # Write local data for preview
    DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(DATA_PATH, "w") as f:
        json.dump(data, f, indent=2)
    print(f"Wrote {DATA_PATH}")

    # Push to TRMNL if configured
    push_to_trmnl(data)


if __name__ == "__main__":
    main()
